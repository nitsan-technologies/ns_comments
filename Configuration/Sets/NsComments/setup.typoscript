@import 'EXT:ns_comments/Configuration/TypoScript/setup.typoscript'

plugin.tx_nscomments {
    view {
        templateRootPaths.0 = {$ns_comments.view.templateRootPath}
        partialRootPaths.0 = {$ns_comments.view.partialRootPath}
        layoutRootPaths.0 = {$ns_comments.view.layoutRootPath}
    }
    settings {
        termsRequired = {$ns_comments.configuration.terms.termsRequired}
        termsText = {$ns_comments.configuration.terms.termsText}
        termsTypolinkParameter = {$ns_comments.configuration.terms.termsTypolinkParameter}
        approveComment = {$ns_comments.configuration.main.approveComment}
        mainConfiguration {
            customDateFormat = {$ns_comments.configuration.main.customDateFormat}
            customTimeFormat = {$ns_comments.configuration.main.customTimeFormat}
            disableCaptcha = {$ns_comments.configuration.main.disableCaptcha}
        }
    }
}

commentAjaxCall = PAGE
commentAjaxCall {
    typeNum = 991
    config {
        disableAllHeaderCode = 1
        xhtml_cleaning = 0
        debug = 0
        no_cache = 1
        admPanel = 0
    }
    315123 = USER
    315123 {
        userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
        pluginName = Comment
        extensionName = NsComments
        controller = Comment
        vendorName = Nitsan
        action = create
        switchableControllerActions {
            Comment {
                1 = create
            }
        }
    }
}

lib.tx_nscomments.comments = USER
lib.tx_nscomments.comments {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = NsComments
    pluginName = Comment
    vendorName = Nitsan
    switchableControllerActions {
        Comment {
            1 = list
        }
    }
    settings < plugin.tx_nscomments.settings
    settings {
        relatedComments = 1
        approveComment = {$ns_comments.configuration.main.approveComment}
    }
}
